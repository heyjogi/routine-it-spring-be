# Environment (docker/prod)
ENVIRONMENT=docker
SPRING_PROFILES_ACTIVE=${ENVIRONMENT}

# Database Configuration
# For local development (docker):
DB_HOST=db
DB_PORT=3307
DB_NAME=routine
DB_USERNAME=root
DB_PASSWORD=rootpassword
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword@

# For production, change to:
# DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
# DB_USERNAME=admin
# DB_PASSWORD=your-secure-password

# MySQL Root Password (for docker only)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=routine

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-for-production
JWT_EXPIRATION=86400000

# Future OAuth support can be added here when needed
# KAKAO_CLIENT_ID=your-kakao-client-id
# KAKAO_CLIENT_SECRET=your-kakao-client-secret
# KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao

# CORS (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Application Port
APP_PORT=8080

JPA_HIBERNATE_DDL_AUTO=update  # 또는 create, create-drop, none
JPA_SHOW_SQL=true              # 또는 false